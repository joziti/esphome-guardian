# Copy this file to secrets.yaml and fill in your own values:
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml is git-ignored. Never commit it.

# Your 2.4 GHz Wi-Fi network.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot the device opens when it can't reach Wi-Fi
# (at least 8 characters).
ap_password: "change-me-too"

# API encryption key: a random 32-byte key in base64. Generate your own:
#   openssl rand -base64 32
# Home Assistant asks for this key when you add the device.
api_encryption_key: "REPLACE-WITH-YOUR-OWN-KEY"

# Over-the-air updates use the API key above; no separate OTA password.
